.vscode/
.idea/
*.swp
.DS_Store

# written by the runtime next to the disc directory
/shadercache/
/keys.txt

# Ghidra project exports hold the game's code
*.gzf
/game.extracting/
/game.old*/

# loose .edb files that take the place of the disc's or come on top, a folder a modpack (port/mods/mods.cpp)
/modpacks/
/mods/

/tas/
