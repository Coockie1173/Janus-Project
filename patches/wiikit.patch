 }
 
+std::atomic<bool> muted{false};
+std::atomic<float> fade_gain{1.0f}, fade_step{0.0f};  // the gain, and what a sample frame adds to it while fading
+void audio_mute(bool on, double fade) {
+    float step = fade > 0 ? (float)(1.0 / (fade * 32000.0)) : 0.0f;
+    if (on && step > 0) {                            // fading out: muted once the gain is down
+        if (!muted) fade_step = -step;
+        return;
+    }
+    if (!on) {
+        if (muted) fade_gain = step > 0 ? 0.0f : 1.0f;
+        else if (step == 0) fade_gain = 1.0f;
+        fade_step = step;                            // a fade out that is turned round comes back from where it is
+    }
+    muted = on;
+}
+
 void audio_play(const uint8_t* be_rl, uint32_t frames, uint32_t rate) {
