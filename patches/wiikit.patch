@@ -0,0 +1,280 @@
+"""Which condition register bits an instruction's result is still read from.
+
+A compare writes four CR bits and the branch after it reads one; the next
+compare overwrites them all. Written into the context, the four stores stay
+(a call in between could read them, for all the C++ compiler knows): about a
+tenth of the recompiled code's time. Here each function's CR bits are followed
+backwards from where they are read, across calls: a bit nothing reads before
+it is written again need not be stored (emit narrows the compare).
+
+Bit i of a mask is CR bit i (c.cr[i]: field i / 4; 0 LT, 1 GT, 2 EQ, 3 SO).
+
+Across a direct call nothing is assumed of the ABI: a function's `use` is what
+it reads before writing (its callees' too), its `ret` is what any caller reads
+after the call before writing. Any function may be called from outside (a
+callback, a thread's entry): `ret` always has CR2-CR4 (callee-saved). An
+indirect call is taken to reach a function that keeps to the ABI (see there).
+The recompiler's --cr-check makes a build that stops where a bit taken for
+dead is read.
+"""
+import re
+
+from .. import ppc
+
+ALL = 0xFFFFFFFF
+
+
+def field(n):
+    return 0xF << (4 * n)
+
+
+SAVED = field(2) | field(3) | field(4)
+
+# what an instruction does to the flow of control
+NEXT, JUMP, COND, CALL, ICALL, RET, TAIL, ITAIL, SWITCH, DIE = range(10)
+
+
+_DEF_FIELD = re.compile(r"\b(?:cr_cmp_[su]|cr_set|fcmp)\(c, (\d)")
+_DEF_BIT = re.compile(r"c\.cr\[(\d+)\] = ")
+_USE_BIT = re.compile(r"c\.cr\[(\d+)\](?! = )")
+_MTCRF = re.compile(r"\bmtcrf\(c, 0x([0-9A-Fa-f]+)u?,")
+
+
+_REG_FIELDS = ("A", "B", "S", "D")
+
+
+def _touches(ins, reg):
+    """Whether the instruction may read or write GPR reg (when in doubt, yes)."""
+    op, f = ins.op, ins.f
+    if op.startswith(("lf", "stf", "psq_")):             # D or S is a floating-point register
+        return f.get("A") == reg or f.get("B") == reg
+    if op in ("addi", "addis"):                          # rA of 0 is the number 0
+        return f["D"] == reg or (f["A"] == reg and reg != 0)
+    return any(f.get(k) == reg for k in _REG_FIELDS)
+
+
+def _mfcr_use(ins, following):
+    """The CR bits an mfcr's value is used for. The compiler takes the whole register to
+    make a truth value of one bit (mfcr rX; rlwinm rX, rX, n, 31, 31); a prologue, a
+    context save or an exception's entry stores it to put it back later (what is put
+    back is read, if ever, by code that had it stored: only the callee-saved fields are
+    counted). Anything else reads it all."""
+    reg = ins.f["D"]
+    for nxt in following:
+        f = nxt.f
+        if nxt.op in ("b", "bc", "bclr", "bcctr"):
+            break
+        if (nxt.op == "stw" and f.get("D") == reg) or (nxt.op == "mtspr" and f.get("D") == reg):
+            return SAVED
+        if nxt.op == "rlwinm" and f.get("S") == reg and f.get("A") == reg:
+            sh, mb, me = f["SH"], f["MB"], f["ME"]
+            use, j = 0, mb
+            while True:                                  # the mask's bits, back where they were
+                use |= 1 << ((j + sh) & 31)
+                if j == me:
+                    break
+                j = (j + 1) & 31
+            return use
+        if _touches(nxt, reg):
+            break
+    return ALL
+
+
+def use_def(lines, ins, following):
+    """(bits read, bits written) by an instruction, from the C++ emitted for it: what
+    the code does, not what the instruction's fields promise."""
+    use = d = 0
+    for text in lines:
+        for m in _DEF_FIELD.finditer(text):
+            d |= field(int(m.group(1)))
+        if "cr0_rc(" in text:
+            d |= field(0)
+        if "cr1_rc(" in text:
+            d |= field(1)
+        for m in _DEF_BIT.finditer(text):
+            d |= 1 << int(m.group(1))
+        for m in _USE_BIT.finditer(text):
+            use |= 1 << int(m.group(1))
+        for m in _MTCRF.finditer(text):
+            for n in range(8):
+                if int(m.group(1), 16) & (0x80 >> n):
+                    d |= field(n)
+        if "mfcr(c)" in text:
+            use = _mfcr_use(ins, following)
+    if ins.op in ("crxor", "creqv") and ins.f["crbA"] == ins.f["crbB"]:
+        use = 0                                          # crclr, crset: the bit is not read
+    return use, d
+
+
+class Analysis:
+    """live(entry, addr): the CR bits read after the instruction at addr, before they are written."""
+
+    def __init__(self, prog, code, log=print):
+        """code: {entry: [lines of each instruction of its body]}."""
+        self.prog = prog
+        self.code = code
+        entries = prog.entries
+        self.entry_set = set(entries)
+        self.fns = {e: self._shape(e) for e in entries}
+        self.use = dict.fromkeys(entries, 0)           # read by the function before it writes them
+        self.ret = dict.fromkeys(entries, SAVED)       # read by a caller after the function returns
+        self.use_any = 0                               # the union of use: what an indirect call may read
+        self.ret_any = SAVED                           # read after an indirect call
+        self.out = {}
+        rounds = 0
+        while True:
+            rounds += 1
+            changed = False
+            for e in entries:
+                changed |= self._flow(e)
+            # An indirect call's target is compiled code or a callback written to be
+            # called from it: of the bits it finds, it reads what the ABI passes (CR1 EQ,
+            # for a variadic function) or has it keep (CR2-CR4). The few functions with
+            # conventions of their own (hand-written, with direct callers) do not count
+            # here; --cr-check finds a target that reads more.
+            any_use = 0
+            for e in entries:
+                any_use |= self.use[e]
+            any_use &= SAVED | 1 << 6
+            if any_use != self.use_any:
+                self.use_any, changed = any_use, True
+            if not changed:
+                break
+        odd = sum(1 for e in entries if self.use[e] & ~SAVED & ~(1 << 6))
+        log(f"  CR liveness: {rounds} rounds; an indirect call reads {self.use_any:08X}, "
+            f"is followed by reads of {self.ret_any:08X}; {odd} functions read CR0/1/5-7 bits "
+            f"(other than CR1 EQ) they did not write")
+
+    def _shape(self, entry):
+        """Per instruction of the entry's body: (use, def, kind, argument)."""
+        prog = self.prog
+        unit, body = prog.body(entry)
+        index = {a: k for k, (a, _) in enumerate(body)}
+        rows = []
+        for k, (a, ins) in enumerate(body):
+            op, f = ins.op, ins.f
+            use, d = use_def(self.code[entry][k], ins, [i for _, i in body[k + 1:k + 5]])
+            kind, arg = NEXT, None
+            cond = op in ("bc", "bclr", "bcctr") and f["BO"] & 0x14 != 0x14
+            if op in ("b", "bc"):
+                t = ppc.branch_target(ins, a)
+                if f["LK"]:
+                    if not (op == "bc" and t == a + 4):
+                        kind, arg = (CALL, (t, True)) if t in self.entry_set else (NEXT, None)
+                elif entry <= t < unit.end and t in index:
+                    kind, arg = (COND if cond else JUMP), index[t]
+                elif t in self.entry_set:
+                    kind, arg = TAIL, (t, cond)
+                else:
+                    kind, arg = DIE, cond
+            elif op == "bclr":
+                kind, arg = (ICALL, None) if f["LK"] else (RET, cond)
+            elif op == "bcctr":
+                if f["LK"]:
+                    kind = ICALL
+                elif not cond and a in prog.tables:
+                    kind, arg = SWITCH, [index[t] for t in set(prog.tables[a]) if t in index]
+                else:
+                    kind, arg = ITAIL, cond
+            elif op == "rfi":
+                kind, arg = DIE, False
+            rows.append((use, d, kind, arg))
+        # past the last instruction: into the next function, or nowhere
+        last = body[-1][1] if body else None
+        from .emit import terminates
+        end = None
+        if last is None or not terminates(last):
+            end = unit.end if unit.end in self.entry_set else -1
+        return rows, end
+
+    def _flow(self, entry):
+        rows, end = self.fns[entry]
+        n = len(rows)
+        ret_self = self.ret[entry] | self.ret_any
+        changed = False
+        live = self.out.get(entry)
+        if live is None:
+            live = self.out[entry] = [0] * (n + 1)     # live[k]: before instruction k; live[n]: off the end
+        if end is None:
+            off_end = 0
+        elif end < 0:
+            off_end = 0
+        else:
+            off_end = self.use[end] | ret_self
+            changed |= self._returns_to(end, ret_self)
+        if live[n] != off_end:
+            live[n] = off_end
+        while True:
+            again = False
+            for k in range(n - 1, -1, -1):
+                use, d, kind, arg = rows[k]
+                after = live[k + 1]
+                if kind == NEXT:
+                    v = after
+                elif kind == JUMP:
+                    v = live[arg]
+                elif kind == COND:
+                    v = after | live[arg]
+                elif kind == CALL:
+                    t = arg[0]
+                    v = after | self.use[t]
+                    changed |= self._returns_to(t, after)
+                elif kind == ICALL:
+                    v = after | self.use_any
+                    if after & ~self.ret_any:
+                        self.ret_any |= after
+                        changed = True
+                elif kind == RET:
+                    v = ret_self | (after if arg else 0)
+                elif kind == TAIL:
+                    t, cond = arg
+                    v = self.use[t] | ret_self | (after if cond else 0)
+                    changed |= self._returns_to(t, ret_self)
+                elif kind == ITAIL:
+                    v = self.use_any | ret_self | (after if arg else 0)
+                    if ret_self & ~self.ret_any:
+                        self.ret_any |= ret_self
+                        changed = True
+                elif kind == SWITCH:
+                    v = self.use_any | ret_self          # (the default: an indirect jump)
+                    for t in arg:
+                        v |= live[t]
+                else:                                    # DIE
+                    v = after if arg else 0
+                v = (v & ~d) | use
+                if v != live[k]:
+                    live[k] = v
+                    again = True
+            if not again:
+                break
+            changed = True
+        if n and live[0] != self.use[entry]:
+            self.use[entry] = live[0]
+            changed = True
+        return changed
+
+    def _returns_to(self, t, after):
+        if after & ~self.ret[t]:
+            self.ret[t] |= after
+            return True
+        return False
+
+    def live_after(self, entry):
+        """{addr: CR bits read after the instruction there} for the entry's body."""
+        _, body = self.prog.body(entry)
+        rows, _ = self.fns[entry]
+        live = self.out[entry]
+        res = {}
+        for k, (a, _) in enumerate(body):
+            use, d, kind, arg = rows[k]
+            # what the instruction's own writes are read by: every way on from it
+            if kind in (NEXT, CALL, ICALL):
+                v = live[k + 1]
+                if kind == CALL:
+                    v |= self.use[arg[0]]
+                elif kind == ICALL:
+                    v |= self.use_any
+            else:
+                v = ALL                                  # (a branch writes no CR: never asked)
+            res[a] = v
+        return res
