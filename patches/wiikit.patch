+// a draw being decoded while its list is built: its vertices kept, and the indices it reaches
+void dl_note_draw(const VtxPlan& pl, const uint8_t* p, size_t len, uint32_t count, const uint8_t* out, size_t bytes) {
+    DlEntry& e = *dl_building;
+    const VtxFmt& f = pl.f;
+    e.draws.push_back(DlDraw{(uint32_t)(p - dl_base), (uint32_t)len, count, (uint32_t)e.vtx.size(), (uint32_t)bytes, 0,
+                             (uint8_t)(p[0] & 0xF8), pl.flags});
+    e.vtx.insert(e.vtx.end(), out, out + bytes);
+    // the stream again, for the indices alone
+    struct At { int arr; uint32_t mode; int direct, n; } at[12];
+    int nat = 0;
+    const int psz = fmt_size(f.pos_fmt), nsz = fmt_size(f.nrm_fmt);
+    const uint32_t nrm = f.lo >> 11 & 3;
+    const bool nbt3 = f.nbt && f.nidx3 && nrm != 1;
+    auto add = [&](int arr, uint32_t mode, int size, int n) {
+        if (!mode) return;
+        at[nat++] = At{arr, mode, size, n};
+        if (mode >= 2) e.elem[arr] = std::max(e.elem[arr], (uint32_t)size);
+    };
+    add(0, f.lo >> 9 & 3, f.pos_n * psz, 1);
+    add(1, nrm, (f.nbt ? 9 : 3) * nsz, nbt3 ? 3 : 1);
+    for (int c = 0; c < 2; ++c) add(2 + c, f.lo >> (13 + 2 * c) & 3, col_size(f.col_fmt[c]), 1);
+    for (int t = 0; t < 8; ++t) add(4 + t, f.hi >> (2 * t) & 3, f.tc_n[t] * fmt_size(f.tc_fmt[t]), 1);
+    const int skip = __builtin_popcount(f.lo & 0x1FF);
+    const uint8_t* q = p + 3;
+    for (uint32_t k = 0; k < count; ++k) {
+        q += skip;
+        for (int i = 0; i < nat; ++i) {
+            const At& a = at[i];
+            if (a.mode == 1) { q += a.direct; continue; }
+            for (int j = 0; j < a.n; ++j) {
+                uint32_t idx;
+                if (a.mode == 2) idx = *q++;
+                else { idx = be16(q); q += 2; }
+                e.lo[a.arr] = std::min(e.lo[a.arr], idx);
+                e.hi[a.arr] = std::max(e.hi[a.arr], idx);
+                ++e.verts[a.arr];
+            }
+        }
+    }
+}
