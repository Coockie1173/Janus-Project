+void frame_log() {
+    static const char* path = std::getenv("WIIKIT_FRAMELOG");
+    if (!path) return;
+    static FILE* f = std::fopen(path, "w");
+    static Stats then;
+    static auto dthen = dl_stat;
+    static const auto t0 = std::chrono::steady_clock::now();
+    if (!f) return;
+    std::fprintf(f, "%llu %.4f draws %llu verts %llu dls %llu kept %llu built %llu plain %llu round %u up %llu gen %u\n",
+                 (unsigned long long)st.frames, std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(),
+                 (unsigned long long)(st.draws - then.draws), (unsigned long long)(st.verts - then.verts),
+                 (unsigned long long)(dl_stat.calls - dthen.calls), (unsigned long long)(dl_stat.kept - dthen.kept),
+                 (unsigned long long)(dl_stat.built - dthen.built), (unsigned long long)(dl_stat.plain - dthen.plain), arena_gen,
+                 (unsigned long long)(st.uploads - then.uploads), tex_gen);
+    then = st;
+    dthen = dl_stat;
+    // and the lists it called, in FILE.lists: frame (u32), how many (u32), their addresses
+    static FILE* lf = std::fopen((std::string(path) + ".lists").c_str(), "wb");
+    if (lf) {
+        const uint32_t head[2] = {(uint32_t)st.frames, (uint32_t)frame_lists.size()};
+        std::fwrite(head, 4, 2, lf);
+        std::fwrite(frame_lists.data(), 4, frame_lists.size(), lf);
+    }
+    frame_lists.clear();
+    // and the textures it bound, in FILE.tex: frame (u32), how many (u32), their addresses
+    static FILE* xf = std::fopen((std::string(path) + ".tex").c_str(), "wb");
+    if (xf) {
+        const uint32_t head[2] = {(uint32_t)st.frames, (uint32_t)frame_texs.size()};
+        std::fwrite(head, 4, 2, xf);
+        std::fwrite(frame_texs.data(), 4, frame_texs.size(), xf);
+    }
+    frame_texs.clear();
