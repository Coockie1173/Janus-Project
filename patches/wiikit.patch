+                Sock* k = sock(s);
+                if (!k) { r = -SO_EBADF; return true; }
+                if (k->connecting == 1) {             // under way: asked again, or the call that waits for it
+                    int cs = connect_state(*k);       // (not connect() again: Winsock would start over)
+                    if (cs == 1) { r = g_so_last = -SO_EALREADY; return k->nonblock; }
+                    if (cs == 2) { r = g_so_last = k->nonblock ? -SO_EISCONN : 0; return true; }
+                    r = g_so_last = k->error ? so_error(k->error, false) : -SO_ECONNREFUSED;
+                    k->error = 0;
+                    return true;
+                }
+                r = so_result(::connect(k->fd, (const sockaddr*)&a, sizeof a), false);
+                if (r >= 0 || r == -SO_EISCONN) { k->connecting = 2; if (!k->nonblock) r = 0; return true; }
