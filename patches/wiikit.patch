+    if (muted) {                                     // the dump still has it
+        if (playing) { SDL_PauseAudioStreamDevice(stream); SDL_ClearAudioStream(stream); playing = false; }
+        return;
+    }
+    if (float g = fade_gain, step = fade_step; g < 1.0f || step < 0) {   // coming back from a mute, or going into one
+        for (uint32_t i = 0; i < frames; ++i) {
+            lr[2 * i] = (int16_t)(lr[2 * i] * g);
+            lr[2 * i + 1] = (int16_t)(lr[2 * i + 1] * g);
+            g = std::clamp(g + step, 0.0f, 1.0f);
+        }
+        fade_gain = g;
+        if (step < 0 && g <= 0 && fade_step < 0) muted = true;
+    }
     if (rate != stream_rate) {
