+    uint64_t ticks = perf_ticks();
+    auto clock = std::chrono::steady_clock::now();
+    if (ticks > ticks_then) {
+        double ns = (double)std::chrono::duration_cast<std::chrono::nanoseconds>(clock - clock_then).count() / (double)(ticks - ticks_then);
