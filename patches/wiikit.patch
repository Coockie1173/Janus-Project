+// The arrays' parts a list just built reaches, hashed. A game's arrays are
+// often one block of whole vertices (position, normal, colour side by side):
+// parts that overlap or touch are hashed as one, once. False: too much of the
+// arrays for what the list uses, or outside memory.
+bool dl_arrays_build(DlEntry& e) {
+    struct Part { uint64_t lo, hi; } parts[12];
+    int n = 0;
+    for (int a = 0; a < 12; ++a) {
+        if (e.lo[a] > e.hi[a]) continue;
+        uint32_t stride = cp[0xB0 + a], addr = (cp[0xA0 + a] & 0x1FFFFFFF) + e.lo[a] * stride;
+        uint64_t len = (uint64_t)(e.hi[a] - e.lo[a]) * stride + e.elem[a];
+        if (len > 4ull * e.verts[a] * e.elem[a] + 4096 || !mem_ok(addr, len)) return false;
+        parts[n++] = Part{addr, addr + len};
+    }
+    std::sort(parts, parts + n, [](const Part& x, const Part& y) { return x.lo < y.lo; });
+    for (int i = 0; i < n;) {
+        Part m = parts[i++];
+        while (i < n && parts[i].lo <= m.hi + 64) { m.hi = std::max(m.hi, parts[i].hi); ++i; }
+        if (!mem_ok((uint32_t)m.lo, m.hi - m.lo)) return false;
+        const uint8_t* at = host(virt((uint32_t)m.lo));
+        const Guard guard = guard_set(at, m.hi - m.lo);
+        e.arrs.push_back(DlArr{(uint32_t)m.lo, (uint32_t)(m.hi - m.lo), dl_hash(at, m.hi - m.lo), guard});
+        dl_stat.bytes += m.hi - m.lo;
+    }
+    return true;
+}
+// are they still what they were (the registers are: the signature was compared first)
+// Watched pages nothing wrote to are not read at all; otherwise they are watched (again) and hashed.
+bool dl_mem_same(const uint8_t* p, size_t n, uint64_t hash, Guard& guard) {
+    if (guard_same(p, n, guard)) return true;
+    guard = guard_set(p, n);
+    dl_stat.bytes += n;
+    return dl_hash(p, n) == hash;
+}
+bool dl_arrays_same(DlEntry& e) {
+    for (DlArr& a : e.arrs)
+        if (!dl_mem_same(host(virt(a.addr)), a.len, a.hash, a.guard)) return false;
+    return true;
+}
