+// A kept list's vertices do not go through the record every frame either:
+// they are put in the renderer's static vertex buffer once (VC_VTXUP), and a
+// draw of them is its place there (VC_DRAWS; draws in a row with nothing
+// between them are one command, as with VC_DRAW). The buffer's room is given
+// out here, front to back; when it is full it starts over, and each list
+// puts its vertices in again the next time it is used.
+const bool dl_static_on = !std::getenv("WIIKIT_NO_STATICVTX");
+uint32_t arena_at = 0, arena_gen = 1;
+// WIIKIT_STATIC_MB: less of the buffer used (a test of starting over)
+const uint32_t arena_cap = std::getenv("WIIKIT_STATIC_MB")
+    ? std::min<uint32_t>(VTX_STATIC_CAP, (uint32_t)std::atoi(std::getenv("WIIKIT_STATIC_MB")) << 20) : VTX_STATIC_CAP;
+size_t sdraw_hdr = 0, sdraw_end = SIZE_MAX;
+bool dl_upload(DlEntry& e) {
+    if (e.vtx.size() + 256 * e.draws.size() > arena_cap / 2) return false;
+    for (int round = 0; round < 2; ++round) {
+        uint32_t at = arena_at;
+        bool fits = true;
+        for (DlDraw& d : e.draws) {
+            uint32_t stride = vtx_layout(d.flags).stride;
+            at = (at + stride - 1) / stride * stride;
+            if ((uint64_t)at + d.bytes > arena_cap) { fits = false; break; }
+            d.first = at / stride;
+            at += d.bytes;
+        }
+        if (fits) break;
+        arena_at = 0;                                // full: from the front again
+        ++arena_gen;
+    }
+    for (const DlDraw& d : e.draws) {
+        uint32_t stride = vtx_layout(d.flags).stride;
+        put<uint8_t>(VC_VTXUP);
+        put<uint32_t>(d.first * stride);
+        put<uint32_t>(d.bytes);
+        std::memcpy(grow(d.bytes), e.vtx.data() + d.at, d.bytes);
+        arena_at = d.first * stride + d.bytes;
+    }
+    e.gen = arena_gen;
+    return true;
+}
+void static_draw(const DlDraw& d) {
+    if (g_vperf_on) {
+        uint64_t t0 = perf_ticks();
+        sync_textures();
+        perf_tex += perf_ticks() - t0;
+    } else {
+        sync_textures();
+    }
+    bool extend = rec.size() == sdraw_end && rec[sdraw_hdr + 1] == d.prim && rec[sdraw_hdr + 2] == d.flags;
+    if (!extend) {
+        sdraw_hdr = rec.size();
+        put<uint8_t>(VC_DRAWS);
+        put<uint8_t>(d.prim);
+        put<uint8_t>(d.flags);
+        put<uint32_t>(0);
+    }
+    put<uint32_t>(d.first);
+    put<uint32_t>(d.count);
+    uint32_t pieces;
+    std::memcpy(&pieces, &rec[sdraw_hdr + 3], 4);
+    ++pieces;
+    std::memcpy(&rec[sdraw_hdr + 3], &pieces, 4);
+    sdraw_end = rec.size();
+    flush(false);
+}
