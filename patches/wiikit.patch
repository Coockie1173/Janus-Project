+// ---- display lists kept decoded ----------------------------------------------------------------
+// A game's world is display lists of indexed vertices called again every
+// frame, and decoding their vertices was most of the command processor's
+// time. A list's decoded vertices are kept, and used again while everything
+// they were made from is what it was: the list's bytes, the vertex formats
+// and array registers, and the part of each array its indices reach (all
+// hashed whole: far less work than decoding). The commands between a list's
+// draws are parsed as ever. A list that changes the vertex format itself, or
+// whose inputs keep changing (skinned vertices), is parsed as before.
+struct DlDraw { uint32_t off, len, count, at, bytes, first; uint8_t prim, flags; };
+struct DlArr { uint32_t addr, len; uint64_t hash; Guard guard; };
+struct DlEntry {
+    enum : uint8_t { NEW, KEPT, PLAIN } state = NEW;
+    bool plain = false;                              // found while building: cannot be kept
+    uint8_t fails = 0;
+    uint32_t size = 0, wait = 0, gen = 0;            // gen: the static buffer's round its vertices were put in
+    uint64_t hash = 0, sig = 0;
+    Guard guard;                                     // of the list's bytes
+    uint32_t lo[12], hi[12], elem[12], verts[12];    // per array: indices reached, bytes an element, vertices
+    std::vector<DlArr> arrs;
+    std::vector<DlDraw> draws;
+    std::vector<uint8_t> vtx;
+};
+std::unordered_map<uint32_t, DlEntry> dl_cache;
+DlEntry* dl_building = nullptr;
+const uint8_t* dl_base = nullptr;
+struct { uint64_t calls, kept, built, plain, bytes, copied; } dl_stat;
+const bool dl_cache_on = !std::getenv("WIIKIT_NO_DLCACHE");
+
+// The lists and their arrays are megabytes a frame: four multiplies side by
+// side, 32 bytes a step (hash_mem's one chain was a third of the saving).
+uint64_t dl_hash(const uint8_t* p, size_t n) {
+    const uint64_t k = 0xFF51AFD7ED558CCDull;
+    uint64_t h[4] = {0x9E3779B97F4A7C15ull ^ n, 0xC2B2AE3D27D4EB4Full, 0x165667B19E3779F9ull, 0x27D4EB2F165667C5ull};
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        uint64_t w[4];
+        std::memcpy(w, p + i, 32);
+        for (int j = 0; j < 4; ++j) { h[j] = (h[j] ^ w[j]) * k; h[j] ^= h[j] >> 29; }
+    }
+    uint64_t r = h[0];
+    for (int j = 1; j < 4; ++j) r = (r ^ h[j]) * k + (r >> 31);
+    for (; i < n; i += 8) {                            // the rest: a word at a time, the last one short
+        uint64_t w = 0;
+        std::memcpy(&w, p + i, std::min<size_t>(8, n - i));
+        r = (r ^ w) * k;
+        r ^= r >> 29;
+    }
+    return r;
+}
+
+// everything outside the list and the arrays that a vertex is decoded through
+bool sig_stale = true;                               // a CP register written since it was worked out
+uint64_t dl_signature() {
+    static uint64_t sig = 0;
+    if (!sig_stale) return sig;
+    sig_stale = false;
+    uint32_t w[4 + 24 + 24];
+    w[0] = cp[0x30]; w[1] = cp[0x40]; w[2] = cp[0x50]; w[3] = cp[0x60];
+    std::memcpy(w + 4, cp + 0x70, 8 * 4);
+    std::memcpy(w + 12, cp + 0x80, 8 * 4);
+    std::memcpy(w + 20, cp + 0x90, 8 * 4);
+    std::memcpy(w + 28, cp + 0xA0, 12 * 4);
+    std::memcpy(w + 40, cp + 0xB0, 12 * 4);
+    return sig = hash_mem(reinterpret_cast<const uint8_t*>(w), sizeof w);
+}
