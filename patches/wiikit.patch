+        }
+        }
+        rt_log("net: /dev/net/ip/top ioctl %u (in %u bytes, out %u) not known: 0", req, in_len, out_len);
+        return 0;
+    }
+
+    int32_t ioctlv(uint32_t req, std::vector<Vec>& in, std::vector<Vec>& io, uint32_t addr) override {
+        switch (req) {
+        case 26: case 27: case 29: return 0;          // startup, cleanup, setinterfaceopt
+        case 13: {                                    // sendto: data; (s, flags, has address, address)
+            if (in.size() < 2) return -SO_EINVAL;
+            uint32_t data = in[0].addr, len = in[0].size, p = in[1].addr;
+            uint32_t s = rd32(p), flags = rd32(p + 4);
+            bool has_dest = rd32(p + 8) != 0;
+            sockaddr_in to = has_dest ? native_addr(p + 0xC) : sockaddr_in{};
+            if (!sock(s)) return -SO_EBADF;
+            auto step = [s, data, len, flags, has_dest, to](int32_t& r) {
+                Sock* k = sock(s);
+                if (!k) { r = -SO_EBADF; return true; }
+                bool nb = k->nonblock || (flags & 4);
+                if (k->tcp && connect_state(*k) == 1) { r = -SO_EAGAIN; return nb; }
+                long n = ::sendto(k->fd, (const char*)host(data), len, NET_NOSIGNAL | (flags & 1 ? MSG_OOB : 0),
+                                  has_dest ? (const sockaddr*)&to : nullptr, has_dest ? sizeof to : 0);
+                r = so_result(n, true);
+                return nb || r != -SO_EAGAIN;
+            };
+            return net_start(addr, (int)s, step);
+        }
+        case 12: {                                    // recvfrom: (s, flags); data, address
+            if (in.empty() || io.empty()) return -SO_EINVAL;
+            uint32_t s = rd32(in[0].addr), flags = rd32(in[0].addr + 4);
+            uint32_t data = io[0].addr, len = io[0].size;
+            uint32_t from = io.size() > 1 && io[1].size >= 8 ? io[1].addr : 0;
+            if (!sock(s)) return -SO_EBADF;
+            auto step = [s, flags, data, len, from](int32_t& r) {
+                Sock* k = sock(s);
+                if (!k) { r = -SO_EBADF; return true; }
+                bool nb = k->nonblock || (flags & 4);
+                if (k->tcp && connect_state(*k) == 1) { r = -SO_EAGAIN; return nb; }
+                sockaddr_in a{};
+                socklen_t n = sizeof a;
+                mem_unwatch(host(data), len);
+                long got = ::recvfrom(k->fd, (char*)host(data), len, (flags & 2 ? MSG_PEEK : 0) | (flags & 1 ? MSG_OOB : 0),
+                                      from ? (sockaddr*)&a : nullptr, from ? &n : nullptr);
+#ifdef _WIN32
+                if (got < 0 && net_errno() == WSAEMSGSIZE) got = (long)len;   // a longer datagram: cut, as elsewhere
+#endif
+                r = so_result(got, true);
+                if (got >= 0 && from) guest_addr(from, a);
+                return nb || r != -SO_EAGAIN;
+            };
+            return net_start(addr, (int)s, step);
+        }
+        case 24: {                                    // getaddrinfo: node, service, hints; results in 0x460 + addresses
+            if (io.empty()) return -SO_EINVAL;
+            std::string node = !in.empty() && in[0].size ? guest_cstr(in[0].addr, in[0].size) : "";
+            std::string service = in.size() > 1 && in[1].size ? guest_cstr(in[1].addr, in[1].size) : "";
+            bool has_hints = in.size() > 2 && in[2].size >= 0x14;
+            addrinfo hints{};
+            if (has_hints) {
+                hints.ai_flags = (int)rd32(in[2].addr);
+                hints.ai_socktype = (int)rd32(in[2].addr + 8);
+                hints.ai_protocol = (int)rd32(in[2].addr + 0xC);
+            }
+            hints.ai_family = AF_INET;
+            uint32_t out = io[0].addr, out_len = io[0].size;
+            net_async(addr, [node, service, hints, out, out_len]() -> std::function<int32_t()> {
+                struct Res { int flags, socktype, protocol; sockaddr_in a; };
+                std::vector<Res> list;
+                addrinfo* res = nullptr;
+                std::string n = mapped_host(node);
+                int ret = ::getaddrinfo(node.empty() ? nullptr : n.c_str(), service.empty() ? nullptr : service.c_str(),
+                                        &hints, &res);
+                if (ret == 0) {
+                    for (addrinfo* p = res; p && list.size() < 8; p = p->ai_next)
+                        if (p->ai_addr && p->ai_family == AF_INET)
+                            list.push_back({p->ai_flags, p->ai_socktype, p->ai_protocol, *(sockaddr_in*)p->ai_addr});
+                    ::freeaddrinfo(res);
+                }
+                if (g_net_log) rt_log("net: getaddrinfo %s: %zu result(s)", node.c_str(), list.size());
+                return [list, out, out_len]() -> int32_t {
+                    if (list.empty()) return -305;        // host not found
+                    uint32_t phys = out & 0x7FFFFFFFu, a = out, sa = out + 0x460;
+                    for (size_t i = 0; i < list.size() && sa + 0x1C <= out + out_len; ++i, a += 0x20, sa += 0x1C) {
+                        wr32(a, (uint32_t)list[i].flags);
+                        wr32(a + 4, 2);
+                        wr32(a + 8, list[i].socktype == SOCK_STREAM ? 1 : list[i].socktype == SOCK_DGRAM ? 2 : 0);
+                        wr32(a + 0xC, (uint32_t)list[i].protocol);
+                        wr32(a + 0x10, 8);
+                        wr32(a + 0x14, 0);
+                        wr32(a + 0x18, sa - out + phys);
+                        guest_addr(sa, list[i].a);
+                        wr32(a + 0x1C, i + 1 < list.size() ? a + 0x20 - out + phys : 0);
+                    }
+                    return 0;
+                };
+            });
+            return PENDING;
+        }
+        case 28: {                                    // getinterfaceopt(0xFFFE, option)
+            if (in.empty() || io.empty()) return -SO_EINVAL;
+            if (rd32(in[0].addr) != 0xFFFE) return -51;
+            uint32_t opt = rd32(in[0].addr + 4), o = io[0].addr;
+            uint32_t len_out = io.size() > 1 ? io[1].addr : 0;
+            switch (opt) {
+            case 0xB003: wr32(o, 0x08080808); wr32(o + 4, 0x08080404); break;     // DNS servers
+            case 0x1003: wr32(o, 0); break;                                      // error
+            case 0x1004: fill(o, mac_address(), 6); break;
+            case 0x1005: wr32(o, 1); break;                                      // link up
+            case 0x3001: wr32(o, 0x10); break;
+            case 0x4002: wr32(o, 1); break;                                      // one address
+            case 0x4003: {                                                       // address, mask, broadcast
+                uint32_t ip = local_ip();
+                if (len_out) wr32(len_out, 0xC);
+                wr32(o, ip); wr32(o + 4, 0xFFFFFF00); wr32(o + 8, ip | 0xFF);
+                break;
+            }
+            case 0x4005: wr32(o, 0x20); break;
+            case 0x4006: {                                                       // routes: the default one
+                uint32_t ip = local_ip();
+                wr32(o, 0); wr32(o + 4, 0); wr32(o + 8, (ip & 0xFFFFFF00) | 1); wr32(o + 12, 1);
+                wr64(o + 16, 0);
+                if (len_out) wr32(len_out, 24);
+                break;
+            }
+            case 0x6003: case 0x600A: case 0x600C: wr32(o, 0x80); break;
+            case 0xB002: wr32(o, 2); break;
+            default: rt_log("net: getinterfaceopt %X not known", opt);
+            }
+            return 0;
+        }
+        }
+        rt_log("net: /dev/net/ip/top ioctlv %u (%zu in, %zu out) not known: 0", req, in.size(), io.size());
+        return 0;
+    }
+};
