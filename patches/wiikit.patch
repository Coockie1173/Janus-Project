+            uint32_t name = rd32(out + 8);
+            if (name == 0x1009) {                     // SO_ERROR
+                int err = 0;
+                socklen_t n = sizeof err;
+                ::getsockopt(k->fd, SOL_SOCKET, SO_ERROR, (char*)&err, &n);
+                if (!err) { err = k->error; k->error = 0; }   // taken when the connection was seen to fail
+                wr32(out + 0xC, 4);
+                wr32(out + 0x10, err ? (uint32_t)so_error(err, false) : 0);
+                return 0;
