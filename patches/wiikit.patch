+// wiikit runtime — IOS's network devices, in high-level emulation. Included by
+// ios.cpp, inside its namespace.
+//
+//   /dev/net/kd/request, /dev/net/kd/time   WiiConnect24: every request succeeds, the time is the host's
+//   /dev/net/ncd/manage                     the console's network configuration: one wired connection, up
+//   /dev/net/ip/top                         sockets, on the host's (BSD sockets), never blocking the
+//                                           console: a call that would wait stays pending and is tried
+//                                           again by the clock thread; names are resolved on a thread
+//   /dev/net/ssl                            TLS on those sockets (OpenSSL); certificates are not verified
+//
+// Request layouts and error numbers follow Dolphin's implementation
+// (Core/IOS/Network), which follows the console's.
+//
+// Names can be given addresses before the host's resolver is asked
+// (ios_net_add_host: a port's own hosts file), which is how a game is pointed
+// at a replacement for servers that no longer exist.
+// (its system headers are included by ios.cpp, outside the namespace)
+
+// ---- names ------------------------------------------------------------------------------------
+std::map<std::string, std::string> g_hosts;           // lower-case name -> address
+bool g_net_log = false;
+
+std::string lower(std::string s) {
+    for (char& c : s) c = (char)std::tolower((unsigned char)c);
+    return s;
+}
+std::string mapped_host(const std::string& name) {
+    auto it = g_hosts.find(lower(name));
+    if (it == g_hosts.end()) return name;
+    if (g_net_log) rt_log("net: %s is %s (hosts)", name.c_str(), it->second.c_str());
+    return it->second;
+}
+
