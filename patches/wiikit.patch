new file mode 100644
index 0000000..3948327
--- /dev/null
+++ b/runtime/ios_net.h
@@ -0,0 +1,753 @@
+// wiikit runtime — IOS's network devices, in high-level emulation. Included by
+// ios.cpp, inside its namespace.
+//
+//   /dev/net/kd/request, /dev/net/kd/time   WiiConnect24: every request succeeds, the time is the host's
+//   /dev/net/ncd/manage                     the console's network configuration: one wired connection, up
+//   /dev/net/ip/top                         sockets, on the host's (BSD sockets), never blocking the
+//                                           console: a call that would wait stays pending and is tried
+//                                           again by the clock thread; names are resolved on a thread
+//   /dev/net/ssl                            TLS on those sockets (OpenSSL); certificates are not verified
+//
+// Request layouts and error numbers follow Dolphin's implementation
+// (Core/IOS/Network), which follows the console's.
+//
+// Names can be given addresses before the host's resolver is asked
+// (ios_net_add_host: a port's own hosts file), which is how a game is pointed
+// at a replacement for servers that no longer exist.
+// (its system headers are included by ios.cpp, outside the namespace)
+
+// ---- names ------------------------------------------------------------------------------------
+std::map<std::string, std::string> g_hosts;           // lower-case name -> address
+bool g_net_log = false;
+
+std::string lower(std::string s) {
+    for (char& c : s) c = (char)std::tolower((unsigned char)c);
+    return s;
+}
+std::string mapped_host(const std::string& name) {
+    auto it = g_hosts.find(lower(name));
+    if (it == g_hosts.end()) return name;
+    if (g_net_log) rt_log("net: %s is %s (hosts)", name.c_str(), it->second.c_str());
+    return it->second;
+}
+
+// ---- errors -----------------------------------------------------------------------------------
+enum : int32_t { SO_EAGAIN = 6, SO_EALREADY = 7, SO_EBADF = 8, SO_ECONNABORTED = 13, SO_ECONNREFUSED = 14,
+                 SO_ECONNRESET = 15, SO_EHOSTUNREACH = 23, SO_EINPROGRESS = 26, SO_EINVAL = 28, SO_EISCONN = 30,
+                 SO_EMSGSIZE = 35, SO_ENETDOWN = 38, SO_ENETRESET = 39, SO_ENETUNREACH = 40, SO_ENOMEM = 49,
+                 SO_ENOTCONN = 56, SO_EPIPE = 66, SO_EPROTONOSUPPORT = 68, SO_EPROTOTYPE = 69, SO_ETIMEDOUT = 76,
+                 SO_EAFNOSUPPORT = 5, SO_EADDRINUSE = 3, SO_EADDRNOTAVAIL = 4, SO_EACCES = 2 };
+int32_t g_so_last = 0;
+
+int32_t so_error(int e, bool rw) {
+    switch (e) {
+    case EAGAIN: return rw ? -SO_EAGAIN : -SO_EINPROGRESS;
+    case EINPROGRESS: return -SO_EINPROGRESS;
+    case EALREADY: return -SO_EALREADY;
+    case EISCONN: return -SO_EISCONN;
+    case ENOTCONN: return -SO_ENOTCONN;
+    case EBADF: case ENOTSOCK: return -SO_EBADF;
+    case ECONNREFUSED: return -SO_ECONNREFUSED;
+    case ECONNRESET: return -SO_ECONNRESET;
+    case ECONNABORTED: return -SO_ECONNABORTED;
+    case ENETUNREACH: return -SO_ENETUNREACH;
+    case EHOSTUNREACH: return -SO_EHOSTUNREACH;
+    case ENETDOWN: return -SO_ENETDOWN;
+    case ENETRESET: return -SO_ENETRESET;
+    case ETIMEDOUT: return -SO_ETIMEDOUT;
+    case EMSGSIZE: return -SO_EMSGSIZE;
+    case EPIPE: return -SO_EPIPE;
+    case EADDRINUSE: return -SO_EADDRINUSE;
+    case EADDRNOTAVAIL: return -SO_EADDRNOTAVAIL;
+    case EACCES: return -SO_EACCES;
+    case EINVAL: return -SO_EINVAL;
+    case ENOMEM: case ENOBUFS: return -SO_ENOMEM;
+    }
+    return -1;
+}
+int32_t so_result(long ret, bool rw) {
+    g_so_last = ret >= 0 ? (int32_t)ret : so_error(errno, rw);
+    return g_so_last;
+}
+
+// ---- sockets ----------------------------------------------------------------------------------
+struct Sock { int fd = -1; bool nonblock = false, tcp = false; int connecting = 0; };   // 0 no, 1 in progress, 2 done, 3 failed
+Sock g_socks[24];
+
+Sock* sock(uint32_t s) { return s < 24 && g_socks[s].fd >= 0 ? &g_socks[s] : nullptr; }
+int host_fd(uint32_t s) { Sock* k = sock(s); return k ? k->fd : -1; }
+
+sockaddr_in native_addr(uint32_t a) {                 // {u8 len, u8 family, u16 port, u32 address}, as on the wire
+    sockaddr_in n{};
+    n.sin_family = AF_INET;
+    std::memcpy(&n.sin_port, host(a + 2), 2);
+    std::memcpy(&n.sin_addr, host(a + 4), 4);
+    return n;
+}
+void guest_addr(uint32_t a, const sockaddr_in& n) {
+    st8(a, 8);
+    st8(a + 1, 2);
+    std::memcpy(host(a + 2), &n.sin_port, 2);
+    std::memcpy(host(a + 4), &n.sin_addr, 4);
+}
+
+// A call that would wait: tried again until it is done or its time is up.
+struct NetOp {
+    uint32_t req;
+    int sock;                                          // the socket it waits on (-1: several, or none)
+    std::function<bool(int32_t&)> step;                // true: done, with the result
+    Clock::time_point deadline = Clock::time_point::max();
+    int32_t late = 0;                                  // the result when the time is up
+};
+std::vector<NetOp> g_netops;
+
+int32_t net_start(uint32_t req, int s, std::function<bool(int32_t&)> step,
+                  Clock::time_point deadline = Clock::time_point::max(), int32_t late = 0) {
+    int32_t r = 0;
+    if (step(r)) return r;
+    g_netops.push_back({req, s, std::move(step), deadline, late});
+    return PENDING;
+}
+
+bool net_update() {                                   // by the clock thread; true while calls wait
+    auto now = Clock::now();
+    for (size_t i = 0; i < g_netops.size();) {
+        NetOp& op = g_netops[i];
+        int32_t r = 0;
+        bool done = op.step(r);
+        if (!done && now >= op.deadline) { done = true; r = op.late; }
+        if (done) {
+            uint32_t req = op.req;
+            g_netops.erase(g_netops.begin() + (long)i);
+            reply(req, r);
+        } else ++i;
+    }
+    return !g_netops.empty();
+}
+
+void net_abort(int s, int32_t result) {               // the socket is closed under its waiting calls
+    for (size_t i = 0; i < g_netops.size();) {
+        if (g_netops[i].sock == s) {
+            reply(g_netops[i].req, result);
+            g_netops.erase(g_netops.begin() + (long)i);
+        } else ++i;
+    }
+}
+
+// Work that takes the host's time (the resolver): on a thread of its own; it
+// returns what to do to the guest's memory, done under the hardware lock.
+void update();
+void net_async(uint32_t req, std::function<std::function<int32_t()>()> work) {
+    std::thread([req, work = std::move(work)] {
+        auto apply = work();
+        hw_run_locked([&] { reply(req, apply()); update(); });
+    }).detach();
+}
+
+uint32_t local_ip() {                                 // host order; the address the default route leaves from
+    static uint32_t ip = 0;
+    if (ip) return ip;
+    int s = ::socket(AF_INET, SOCK_DGRAM, 0);
+    sockaddr_in a{};
+    a.sin_family = AF_INET;
+    a.sin_port = htons(53);
+    inet_pton(AF_INET, "8.8.8.8", &a.sin_addr);
+    socklen_t n = sizeof a;
+    if (s >= 0 && ::connect(s, (sockaddr*)&a, sizeof a) == 0 && ::getsockname(s, (sockaddr*)&a, &n) == 0)
+        ip = ntohl(a.sin_addr.s_addr);
+    if (s >= 0) ::close(s);
+    if (!ip) ip = 0x0A00011E;                         // 10.0.1.30
+    return ip;
+}
+
+// The console's MAC address: made once, kept in the NAND folder.
+const uint8_t* mac_address() {
+    static uint8_t mac[6];
+    static bool have = false;
+    if (have) return mac;
+    std::string p = g_nand + "/mac.bin";
+    FILE* f = std::fopen(p.c_str(), "rb");
+    if (f && std::fread(mac, 1, 6, f) == 6) have = true;
+    if (f) std::fclose(f);
+    if (!have) {
+        uint64_t r = (uint64_t)std::chrono::system_clock::now().time_since_epoch().count() * 0x9E3779B97F4A7C15ull;
+        mac[0] = 0x00; mac[1] = 0x17; mac[2] = 0xAB;  // a Nintendo prefix
+        mac[3] = (uint8_t)(r >> 40); mac[4] = (uint8_t)(r >> 32); mac[5] = (uint8_t)(r >> 24);
+        if ((f = std::fopen(p.c_str(), "wb"))) { std::fwrite(mac, 1, 6, f); std::fclose(f); }
+        have = true;
+    }
+    return mac;
+}
+
+int wii_events(int native, bool to_wii) {
+    static const int map[][2] = {{POLLRDNORM, 0x01}, {POLLRDBAND, 0x02}, {POLLPRI, 0x04}, {POLLWRNORM, 0x08},
+                                 {POLLWRBAND, 0x10}, {POLLERR, 0x20}, {POLLHUP, 0x40}, {POLLNVAL, 0x80}};
+    int out = 0;
+    for (auto& m : map)
+        if (native & m[to_wii ? 0 : 1]) out |= m[to_wii ? 1 : 0];
+    return out;
+}
+
+int connect_state(Sock& k) {                          // a connection in progress: has it ended?
+    if (k.connecting != 1) return k.connecting;
+    pollfd p{k.fd, POLLOUT, 0};
+    if (::poll(&p, 1, 0) > 0) {
+        int err = 0;
+        socklen_t n = sizeof err;
+        ::getsockopt(k.fd, SOL_SOCKET, SO_ERROR, &err, &n);
+        k.connecting = (p.revents & (POLLERR | POLLHUP)) || err ? 3 : 2;
+    }
+    return k.connecting;
+}
+
+struct IPTop : Device {
+    int32_t ioctl(uint32_t req, uint32_t in, uint32_t in_len, uint32_t out, uint32_t out_len, uint32_t addr) override {
+        switch (req) {
+        case 15: {                                    // socket(af, type, protocol)
+            uint32_t af = rd32(in), type = rd32(in + 4), prot = rd32(in + 8);
+            if (af != 2) return -SO_EAFNOSUPPORT;
+            if (prot != 0) return -SO_EPROTONOSUPPORT;
+            if (type != 1 && type != 2) return -SO_EPROTOTYPE;
+            int fd = ::socket(AF_INET, type == 1 ? SOCK_STREAM : SOCK_DGRAM, 0);
+            if (fd < 0) return so_result(-1, false);
+            ::fcntl(fd, F_SETFL, ::fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+            if (type == 2) { int on = 1; ::setsockopt(fd, SOL_SOCKET, SO_BROADCAST, &on, sizeof on); }
+            for (int i = 0; i < 24; ++i)
+                if (g_socks[i].fd < 0) {
+                    g_socks[i] = Sock{fd, false, type == 1, 0};
+                    if (g_net_log) rt_log("net: socket %d (%s)", i, type == 1 ? "TCP" : "UDP");
+                    return g_so_last = i;
+                }
+            ::close(fd);
+            return -33;                               // EMFILE
+        }
+        case 3: {                                     // close
+            uint32_t s = rd32(in);
+            Sock* k = sock(s);
+            if (!k) return -SO_EBADF;
+            ::close(k->fd);
+            *k = Sock{};
+            net_abort((int)s, -SO_ENOTCONN);
+            if (g_net_log) rt_log("net: socket %u closed", s);
+            return 0;
+        }
+        case 2: {                                     // bind(s, has address, address)
+            Sock* k = sock(rd32(in));
+            if (!k) return -SO_EBADF;
+            sockaddr_in a = native_addr(in + 8);
+            int32_t r = so_result(::bind(k->fd, (sockaddr*)&a, sizeof a), false);
+            if (g_net_log) rt_log("net: bind %u to %s:%u -> %d", rd32(in), inet_ntoa(a.sin_addr), ntohs(a.sin_port), r);
+            return r;
+        }
+        case 4: {                                     // connect
+            uint32_t s = rd32(in);
+            Sock* k = sock(s);
+            if (!k) return -SO_EBADF;
+            sockaddr_in a = native_addr(in + 8);
+            if (g_net_log) rt_log("net: connect %u to %s:%u", s, inet_ntoa(a.sin_addr), ntohs(a.sin_port));
+            auto step = [s, a](int32_t& r) {
+                Sock* k = sock(s);
+                if (!k) { r = -SO_EBADF; return true; }
+                r = so_result(::connect(k->fd, (const sockaddr*)&a, sizeof a), false);
+                if (r >= 0 || r == -SO_EISCONN) { k->connecting = 2; if (!k->nonblock) r = 0; return true; }
+                if (r == -SO_EINPROGRESS || r == -SO_EALREADY || r == -SO_EAGAIN) {
+                    k->connecting = 1;
+                    return k->nonblock;
+                }
+                k->connecting = 3;
+                return true;
+            };
+            return net_start(addr, (int)s, step, Clock::now() + std::chrono::seconds(30), -SO_ENETUNREACH);
+        }
+        case 1: {                                     // accept
+            uint32_t s = rd32(in);
+            if (!sock(s)) return -SO_EBADF;
+            auto step = [s, out, out_len](int32_t& r) {
+                Sock* k = sock(s);
+                if (!k) { r = -SO_EBADF; return true; }
+                sockaddr_in a{};
+                socklen_t n = sizeof a;
+                int fd = ::accept(k->fd, (sockaddr*)&a, &n);
+                if (fd < 0) {
+                    r = so_result(-1, true);
+                    return k->nonblock || r != -SO_EAGAIN;
+                }
+                ::fcntl(fd, F_SETFL, ::fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+                for (int i = 0; i < 24; ++i)
+                    if (g_socks[i].fd < 0) {
+                        g_socks[i] = Sock{fd, false, true, 2};
+                        if (out && out_len >= 8) guest_addr(out, a);
+                        r = i;
+                        return true;
+                    }
+                ::close(fd);
+                r = -33;
+                return true;
+            };
+            return net_start(addr, (int)s, step);
+        }
+        case 5: {                                     // fcntl(s, cmd, arg): only the non-blocking flag (4)
+            Sock* k = sock(rd32(in));
+            if (!k) return -SO_EBADF;
+            uint32_t cmd = rd32(in + 4), arg = rd32(in + 8);
+            if (cmd == 3) return k->nonblock ? 4 : 0;
+            if (cmd == 4) k->nonblock = (arg & 4) != 0;
+            return 0;
+        }
+        case 14: {                                    // shutdown(s, how)
+            Sock* k = sock(rd32(in));
+            if (!k) return -SO_EBADF;
+            if (!k->tcp) return 0;
+            int32_t r = so_result(::shutdown(k->fd, (int)rd32(in + 4)), false);
+            net_abort((int)rd32(in), -SO_ENOTCONN);
+            return r;
+        }
+        case 10: {                                    // listen(s, backlog)
+            Sock* k = sock(rd32(in));
+            if (!k) return -SO_EBADF;
+            return so_result(::listen(k->fd, (int)rd32(in + 4)), false);
+        }
+        case 8: {                                     // getsockopt: (s, level, name) in the output, then length, value
+            Sock* k = sock(rd32(out));
+            if (!k) return -SO_EBADF;
+            uint32_t name = rd32(out + 8);
+            if (name == 0x1009) {                     // SO_ERROR
+                int err = 0;
+                socklen_t n = sizeof err;
+                ::getsockopt(k->fd, SOL_SOCKET, SO_ERROR, &err, &n);
+                wr32(out + 0xC, 4);
+                wr32(out + 0x10, err ? (uint32_t)so_error(err, false) : 0);
+                return 0;
+            }
+            int v = 0;
+            socklen_t n = sizeof v;
+            int nat = name == 0x4 ? SO_REUSEADDR : name == 0x1001 ? SO_SNDBUF : name == 0x1002 ? SO_RCVBUF :
+                      name == 0x1008 ? SO_TYPE : -1;
+            int32_t r = nat < 0 ? 0 : so_result(::getsockopt(k->fd, SOL_SOCKET, nat, &v, &n), false);
+            if (name == 0x1008) v = k->tcp ? 1 : 2;
+            wr32(out + 0xC, 4);
+            wr32(out + 0x10, (uint32_t)v);
+            return r;
+        }
+        case 9: {                                     // setsockopt(s, level, name, length, value)
+            Sock* k = sock(rd32(in));
+            if (!k) return -SO_EBADF;
